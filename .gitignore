# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# package manager caches
/.npm
/.pnpm-store

# editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*.orig

# testing and coverage
/coverage
.eslintcache

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist
/.turbo/

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt in for committing if needed)
.env*
!.env.example

# prisma sqlite database
/dev.db
/dev.db-journal
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo

/app/generated/prisma
