# ---- Core ----
# Supabase → Connect → ORMs → Prisma (copy BOTH strings verbatim from the dashboard).
#
# Pooler URLs (aws-*-*.pooler.supabase.com) use username postgres.[project-ref].
# Direct URLs (db.[project-ref].supabase.co) use username postgres — not for Vercel runtime.
# Password = Database password (Settings → Database), NOT the anon/service API keys.
# URL-encode special characters in the password (@ → %40, # → %23, etc.).
#
# Vercel / serverless: DATABASE_URL MUST be the Transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler for Prisma migrations (port 5432). Required on Vercel for `vercel-build`.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# Public base URL of the app (used to build OAuth redirect URIs).
APP_URL="http://localhost:3000"

# ---- Supabase Auth ----
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# Publishable key (sb_publishable_...) from Project Settings → API Keys.
# Safe to expose in the browser. Replaces the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ---- Security ----
# 32-byte key used to encrypt LinkedIn tokens at rest.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Protects /api/cron/tick in production (Vercel sends Authorization: Bearer …).
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# ---- LinkedIn OAuth ----
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# OAuth callback is always ${APP_URL}/api/auth/linkedin/callback (register that URL in the LinkedIn app).

# ---- AI model (managed from the Settings page) ----
# AI provider API keys (Gemini, DeepSeek, …) and the active model are now
# configured in the UI under /settings and stored encrypted in the DB.
# No GEMINI_API_KEY / model env vars are read anymore.

# ---- Publishing ----
# Versioned LinkedIn REST API date (YYYYMM) sent as the LinkedIn-Version header.
LINKEDIN_API_VERSION="202605"
# Generation/publishing schedules are configured in the UI under /settings.
# Give up (mark a draft FAILED) after this many publish attempts.
MAX_PUBLISH_ATTEMPTS="5"
# Max approved drafts published per publisher tick (rate-limit guard).
PUBLISH_BATCH_SIZE="5"
