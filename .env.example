# ---- Core ----
# Supabase Postgres connection string (Project Settings → Database).
# Use the "Transaction" pooler URL for serverless (port 6543) on Vercel.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations (port 5432). Optional locally if DATABASE_URL is direct.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# Public base URL of the app (used to build OAuth redirect URIs).
APP_URL="http://localhost:3000"

# ---- Supabase Auth ----
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# Publishable key (sb_publishable_...) from Project Settings → API Keys.
# Safe to expose in the browser. Replaces the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ---- Security ----
# 32-byte key used to encrypt LinkedIn tokens at rest.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Protects /api/cron/tick in production (Vercel sends Authorization: Bearer …).
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# ---- LinkedIn OAuth ----
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Defaults to ${APP_URL}/api/auth/linkedin/callback if left blank.
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"

# ---- AI model (managed from the Settings page) ----
# AI provider API keys (Gemini, DeepSeek, …) and the active model are now
# configured in the UI under /settings and stored encrypted in the DB.
# No GEMINI_API_KEY / model env vars are read anymore.

# ---- Publishing ----
# Versioned LinkedIn REST API date (YYYYMM) sent as the LinkedIn-Version header.
LINKEDIN_API_VERSION="202605"
# Generation/publishing schedules are configured in the UI under /settings.
# Give up (mark a draft FAILED) after this many publish attempts.
MAX_PUBLISH_ATTEMPTS="5"
# Max approved drafts published per publisher tick (rate-limit guard).
PUBLISH_BATCH_SIZE="5"
